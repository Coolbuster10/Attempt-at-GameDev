; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Project Bramble"
config/description="2D adventure / platformer / fighting prototype."
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.8", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Controls="*res://scripts/autoload/controls.gd"
Game="*res://scripts/autoload/game.gd"
PostFX="*res://scripts/autoload/post_fx.gd"
Dialogue="*res://scripts/autoload/dialogue.gd"
PauseMenu="*res://scripts/autoload/pause_menu.gd"
Transition="*res://scripts/autoload/transition.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[gui]

common/auto_focus_strategy=1

[input_devices]

joypads/ignore_joypad_on_unfocused_application=true

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="oneway"
2d_physics/layer_3="player"
2d_physics/layer_4="actors"
2d_physics/layer_5="triggers"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
lights_and_shadows/multi_bounce_occlusion/enabled=true
